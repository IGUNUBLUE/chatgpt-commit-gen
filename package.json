{
  "name": "chatgpt-commit-gen",
  "displayName": "ChatGPT Commit Gen",
  "description": "Generate Conventional Commit messages from staged Git changes using your ChatGPT subscription.",
  "version": "0.4.0",
  "publisher": "IGUNUBLUE",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IGUNUBLUE/chatgpt-commit-gen"
  },
  "homepage": "https://github.com/IGUNUBLUE/chatgpt-commit-gen",
  "bugs": {
    "url": "https://github.com/IGUNUBLUE/chatgpt-commit-gen/issues"
  },
  "keywords": [
    "git",
    "commit",
    "conventional-commits",
    "chatgpt",
    "openai",
    "ai"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitGenerator.generate",
        "title": "Generate Commit Message",
        "category": "Commit Generator",
        "icon": "$(sparkle)"
      },
      {
        "command": "commitGenerator.cancel",
        "title": "Cancel Commit Message Generation",
        "category": "Commit Generator",
        "icon": "$(loading~spin)"
      },
      {
        "command": "commitGenerator.signIn",
        "title": "Sign in with ChatGPT",
        "category": "Commit Generator"
      },
      {
        "command": "commitGenerator.signOut",
        "title": "Sign out of ChatGPT",
        "category": "Commit Generator"
      },
      {
        "command": "commitGenerator.setModel",
        "title": "Set Model",
        "category": "Commit Generator"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitGenerator.generate",
          "group": "navigation",
          "when": "!commitGenerator.generating"
        },
        {
          "command": "commitGenerator.cancel",
          "group": "navigation",
          "when": "commitGenerator.generating"
        }
      ],
      "commandPalette": [
        {
          "command": "commitGenerator.cancel",
          "when": "commitGenerator.generating"
        }
      ]
    },
    "configuration": {
      "title": "Commit Generator",
      "properties": {
        "commitGenerator.model": {
          "type": "string",
          "default": "gpt-6-luna",
          "description": "Model slug served by your ChatGPT subscription (e.g. gpt-6-luna, gpt-6-sol, gpt-5.6-terra)."
        },
        "commitGenerator.maxDiffChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum number of diff characters sent to the model. Longer diffs are truncated."
        },
        "commitGenerator.excludeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/package-lock.json",
            "**/npm-shrinkwrap.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/bun.lock",
            "**/bun.lockb",
            "**/Cargo.lock",
            "**/poetry.lock",
            "**/uv.lock",
            "**/Pipfile.lock",
            "**/composer.lock",
            "**/Gemfile.lock",
            "**/go.sum",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.map"
          ],
          "markdownDescription": "Glob patterns (git pathspec globs) whose diff content is not sent to the model, e.g. lockfiles and generated files. Matching files are still listed in the `git diff --stat` summary."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
